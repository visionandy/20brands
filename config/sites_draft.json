{
  "version": "1.0",
  "description": "20 个 deal 站点配置草稿。每个站点需填写 deal 列表页 URL，以及该站点的解析规则（选择器或解析方式）。",
  "global": {
    "request_delay_sec": [3, 5],
    "page_dwell_sec": [8, 18],
    "timeout_sec": 45,
    "use_selenium": true,
    "output_dir": "output",
    "fetch_detail": false
  },
  "deal_fields": [
    "title",
    "current_price",
    "original_price",
    "deal_url",
    "image_url",
    "source_site",
    "posted_at",
    "expires_at"
  ],
