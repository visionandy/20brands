{
  "version": "1.0",
  "description": "20 个 deal 站点配置草稿。每个站点需填写 deal 列表页 URL，以及该站点的解析规则（选择器或解析方式）。",
  "global": {
    "request_delay_sec": [3, 5],
    "page_dwell_sec": [8, 18],
    "timeout_sec": 40,
    "max_workers": 4,
    "use_selenium": true,
    "output_dir": "output",
    "fetch_detail": false,
    "original_price_fallback_selectors": ["span.h-text-line-through", "del", "s"],
    "title_clean": {
      "remove_whole_line_labels": ["sale", "new", "clearance", "hot"],
      "remove_line_if_contains": ["current price", "original price"],
      "price_only_line_pattern": "^\\s*[$€£]?\\s*[\\d,]+\\.?\\d*\\s*$"
    }
  },
  "deal_fields": [
    "Product_name",
    "current_price",
    "original_price",
    "Product_link",
    "image_url",
    "Brand",
    "posted_at",
    "expires_at"
  ],
