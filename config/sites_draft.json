      "force_us_locale": true,
      "proxy": "",
      "headless": false,
      "selectors": {
        "container": "article.product-tile-container",
        "title": "h2.pdp-link a, .pdp-link a",
        "current_price": ".price .sales .value",
        "original_price": ".price .list, .price .list .value",
        "deal_url": "a.product-tile-image-link, a[href*='.html']:not([href*='Wishlist'])",
        "image_url": "img.tile-image[src*='michaelkors.scene7.com'], img[src*='michaelkors.scene7.com']"
      },
      "fetch_html": {
        "wait_for_selector": "article.product-tile-container, a.product-tile-image-link",
        "scroll_before_save": true,
        "dismiss_consent": true
      },
      "fetch_detail": true,
      "detail_selectors": {
        "image_list": "img[src*='michaelkors.scene7.com']"
      }
    },
