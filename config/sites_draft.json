    {
      "id": "site_01",
      "name": "michaelkors",
      "list_url": "https://www.michaelkors.global/my/en/sale/",
      "notes": "官方网站michaelkors.global",
      "selectors": {
        "container": "article.product-tile-container",
        "title": "h2.pdp-link a",
        "current_price": ".price .sales .value",
        "original_price": ".price .list .value",
        "deal_url": "h2.pdp-link a",
        "image_url": ".image-container img.tile-image"
      },
      "fetch_detail": false,
      "detail_selectors": {}
    },
